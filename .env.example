# Copy to .env (git-ignored) and fill in. Never commit real values.

# Supabase pooler, Session mode (jobs, loaders, local scripts). Role: job_writer.
# Copy the shape from Supabase > Connect > Session pooler; the user is "<role>.<project-ref>".
DATABASE_URL=postgresql://job_writer.<project-ref>:<password>@<pooler-host>:5432/postgres

# Read-only role, used only by the API (Azure Container App secret).
DATABASE_URL_READONLY=postgresql://api_readonly.<project-ref>:<password>@<pooler-host>:5432/postgres

# Live data sources
DATA_GOV_IN_API_KEY=<your data.gov.in key>
OPENAQ_API_KEY=<optional, only if OpenAQ is used for backfill>

# API / frontend
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
