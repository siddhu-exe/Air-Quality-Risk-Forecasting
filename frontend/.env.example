# Copy to .env.local. Names only; never commit secrets.

# Base URL of the Delhi Air Forecast API (docs/TIER_3/PLAN.md section 5).
# A relative path goes through the Vite dev proxy to http://localhost:8000.
# On Vercel set the full URL, e.g. https://<container-app>.azurecontainerapps.io/api/v1
VITE_API_BASE_URL=/api/v1

# Serve built-in sample data instead of calling the API.
# Defaults to true until the live API exists; set to "false" to use VITE_API_BASE_URL.
VITE_USE_MOCK=true
